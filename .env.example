# ============================================================
# Salin file ini menjadi .env.local (lokal) atau isi di
# Vercel → Project → Settings → Environment Variables.
# ============================================================

# --- Database ------------------------------------------------
# Lokal: KOSONGKAN → otomatis memakai SQLite di ./data/elfifa.db
# Produksi (Vercel): WAJIB diisi dengan database Turso/libSQL.
#   Contoh: libsql://elfifa-namaanda.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Keamanan admin -------------------------------------------
# WAJIB di produksi. String acak minimal 32 karakter, contoh hasil:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Akun admin pertama (dipakai hanya saat belum ada admin sama sekali).
# Setelah login pertama, ganti password dari menu Pengaturan.
ADMIN_EMAIL=admin@elfifa.id
ADMIN_PASSWORD=

# --- Domain (opsional) ----------------------------------------
# NEXT_PUBLIC_MAIN_URL=https://elfifa.vercel.app
# NEXT_PUBLIC_KBIHU_URL=https://kbihu-elfifa.vercel.app
